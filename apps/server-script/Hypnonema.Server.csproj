<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Hypnonema.Server.net</AssemblyName>
		<TargetFramework>net481</TargetFramework>
		<LangVersion>latest</LangVersion>
		<!-- 2.0.0 is the local/dev default; CI overrides it via the VERSION environment variable (or -p:Version=). -->
		<Version Condition="'$(Version)' == ''">2.0.0</Version>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<DebugType>portable</DebugType>
		<OutDir>.\dist\</OutDir>
		<AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
		<!-- node_modules holds the pnpm symlink to @hypnonema/shared-library; keep the SDK
		     glob out of it (and out of dist) so its .cs / obj AssemblyInfo don't get compiled in. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;dist\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="dist\**" />
		<EmbeddedResource Remove="dist\**" />
		<None Remove="dist\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="package.json" />
		<Content Remove="tgconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="package.json" />
		<None Include="tgconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CitizenFX.Core.Server" Version="1.0.26803" ExcludeAssets="runtime" PrivateAssets="all" />
		<PackageReference Include="DotNetZip" Version="1.16.0" />
		<PackageReference Include="Newtonsoft.Json" Version="12.0.2" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
		<PackageReference Include="TypeGen" Version="6.0.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\packages\shared-library\Hypnonema.Shared.csproj" />
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(PkgNewtonsoft_Json)\lib\portable-net40+sl5+win8+wp8+wpa81\Newtonsoft.Json.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Net.Http" />
	</ItemGroup>

	<Target Name="GenerateTypeScript" AfterTargets="Build">
		<Exec Command="dotnet tool run dotnet-typegen generate" />
	</Target>

</Project>
